<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GNUstep Instruments</vendor>
  <vendor_url>https://github.com/danjboyd</vendor_url>

  <action id="org.gnustep.instruments.helper">
    <description>Sample a running process</description>
    <message>GNUstep Instruments needs permission to sample a running process with the kernel's performance counters.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/gstrace-helper</annotate>
  </action>
</policyconfig>
