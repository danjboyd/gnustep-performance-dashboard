        "homepage": "https://github.com/danjboyd/plugins-themes-Adwaita",
        "stageRelativePath": "metadata/licenses/Adwaita-theme.txt"
      },
      {
        "name": "Bundled distribution libraries",
        "license": "Various; see host-libraries/ copyright files",
        "source": "Debian packages listed in host-libraries.txt",
        "stageRelativePath": "metadata/licenses/host-libraries.txt"
      }
    ]
  },
  "backends": {
    "msi": {
      "enabled": false,
      "updates": {
        "feedUrl": "https://danjboyd.github.io/gnustep-performance-dashboard/updates/windows/stable.json"
      }
    },
    "appimage": {
      "enabled": true,
      "desktopEntryName": "io.github.danjboyd.PerformanceDashboard.desktop",
      "iconRelativePath": "metadata/icons/PerformanceDashboard.png",
      "validation": {
        "runtimeClosure": "strict"
      },
      "smoke": {
        "mode": "launch-only"
      },
      "updates": {
        "feedUrl": "https://danjboyd.github.io/gnustep-performance-dashboard/updates/linux/stable.json",
        "embedUpdateInformation": true,
        "releaseSelector": "latest"
      }
    }
  },
  "platformOverrides": {
    "windows": {
      "pipeline": {
        "workingDirectory": "..",
        "shell": {
          "kind": "pwsh",
          "bootstrapCommands": [],
          "environment": {}
        },
        "build": {
          "command": "./scripts/package-build-windows.ps1"
        },
        "stage": {
          "command": "./scripts/package-stage-windows.ps1 -StageRoot dist/stage",
          "outputRoot": "../dist/stage"
        }
      },
      "payload": {
        "runtimeSeedPaths": [
          "runtime/bin/defaults.exe"
        ]
      },
      "launch": {
        "entryRelativePath": "app/PerformanceDashboard.app/PerformanceDashboard.exe",
        "workingDirectory": "app/PerformanceDashboard.app",
        "arguments": [],
        "pathPrepend": [
          "runtime/bin"
        ],
        "env": null
      },
      "themeInputs": [
        {
          "name": "WinUITheme",
          "repo": "https://github.com/danjboyd/plugins-themes-winuitheme.git",
          "ref": "906e462ca6f3c42d4463cc2f22277888436cda21",
          "platforms": [
            "msi"
          ],
          "required": true,
          "default": true
        }
      ],
      "packagedDefaults": {
        "defaultTheme": "WinUITheme"
      },
      "validation": {
        "smoke": {
          "requiredPaths": [
            "app/PerformanceDashboard.app/PerformanceDashboard.exe",
            "app/PerformanceDashboard.app/Resources/Info-gnustep.plist",
            "app/PerformanceDashboard.app/Resources/gsperf-agent.dll",
            "metadata/icons/PerformanceDashboard.ico",
            "metadata/licenses/PerformanceDashboard.txt",
            "runtime/bin/defaults.exe",
            "runtime/bin/gstrace.exe",
            "runtime/bin/GNUstep.conf",
            "runtime/System/Tools/gdnc.exe"
          ]
        },
        "packageContract": {
          "requiredContent": [
            {
              "kind": "notice-report"
            },
            {
              "kind": "bundled-theme",
              "name": "WinUITheme"
            }
          ]
        },
        "installedResult": null
      },
      "compliance": {
