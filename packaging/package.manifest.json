{
  "$schema": "./../../gnustep/gnustep-packager/schemas/gnustep-packager.schema.json",
  "schemaVersion": 1,
  "profiles": [
    "gnustep-gui"
  ],
  "package": {
    "id": "io.github.danjboyd.PerformanceDashboard",
    "name": "PerformanceDashboard",
    "displayName": "Performance Dashboard",
    "version": "0.1.1",
    "manufacturer": "Daniel Boyd",
    "summary": "Performance analysis for GNUstep applications.",
    "description": "Performance Dashboard records a GNUstep program and shows where its time and memory go: Time Profiler, Hangs, Allocations, Leaks, Zombies, File Activity, Network and signposts, on a timeline with call trees.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/danjboyd/gnustep-performance-dashboard"
  },
  "pipeline": {
    "workingDirectory": "..",
    "shell": {
      "kind": "bash",
      "bootstrapCommands": [],
      "environment": {}
    },
    "build": {
      "command": "./scripts/package-build.sh"
    },
    "stage": {
      "command": "./scripts/package-stage.sh dist/stage",
      "outputRoot": "../dist/stage"
    }
  },
  "payload": {
    "layoutVersion": 1,
    "stageRoot": "../dist/stage",
    "appRoot": "app",
    "runtimeRoot": "runtime",
    "metadataRoot": "metadata",
    "runtimeSeedPaths": [
      "runtime/bin/defaults"
    ]
  },
  "launch": {
    "entryRelativePath": "app/PerformanceDashboard.app/PerformanceDashboard",
    "workingDirectory": "app/PerformanceDashboard.app",
    "arguments": [],
    "env": {
      "GNUSTEP_CONFIG_FILE": "{@runtimeRoot}/etc/GNUstep/GNUstep.conf",
      "LD_LIBRARY_PATH": "{@runtimeRoot}/lib",
      "GSTheme": {
        "value": "Adwaita",
        "policy": "ifUnset"
      }
    }
  },
  "outputs": {
    "root": "../dist",
    "packageRoot": "../dist/packages",
    "logRoot": "../dist/logs",
    "tempRoot": "../dist/tmp",
    "validationRoot": "../dist/validation"
  },
  "validation": {
    "smoke": {
      "enabled": true,
      "kind": "staged-layout",
      "requiredPaths": [
        "app/PerformanceDashboard.app/PerformanceDashboard",
        "app/PerformanceDashboard.app/Resources/Info-gnustep.plist",
        "app/PerformanceDashboard.app/Resources/libgsperf-agent.so",
        "app/PerformanceDashboard.app/Resources/gstrace-helper",
        "app/PerformanceDashboard.app/Resources/org.gnustep.performancedashboard.policy",
        "metadata/icons/PerformanceDashboard.png",
        "metadata/licenses/PerformanceDashboard.txt",
        "metadata/licenses/host-libraries.txt",
        "runtime/bin/defaults",
        "runtime/bin/make_services",
        "runtime/bin/gstrace",
        "runtime/etc/GNUstep/GNUstep.conf",
        "runtime/etc/GNUstep/GlobalDefaults.plist",
        "runtime/lib/libGSPerformance.so.0",
        "runtime/lib/libgnustep-gui.so.0.32",
        "runtime/System/Library/Bundles/libgnustep-back-032.bundle/libgnustep-back-032",
        "runtime/System/Library/Themes/Adwaita.theme/Adwaita",
        "runtime/bin/gstrace-bin"
      ],
      "timeoutSeconds": 30
    },
    "logs": {
      "retainOnSuccess": true
    },
    "packageContract": {
      "requiredContent": [
        {
          "kind": "notice-report"
        },
        {
          "kind": "bundled-theme",
          "name": "Adwaita"
        },
        {
          "kind": "metadata-file",
          "path": "metadata/icons/PerformanceDashboard.png"
        }
      ]
    },
    "installedResult": {
      "requiredContent": [
        {
          "kind": "notice-report"
        },
        {
          "kind": "bundled-theme",
          "name": "Adwaita"
        }
      ],
      "requiredPaths": [
        "usr/metadata/icons/PerformanceDashboard.png",
        "usr/runtime/etc/GNUstep/GlobalDefaults.plist",
        "usr/app/PerformanceDashboard.app/Resources/libgsperf-agent.so",
        "usr/runtime/bin/gstrace-bin"
      ]
    }
  },
  "updates": {
    "enabled": true,
    "provider": "github-release-feed",
    "channel": "stable",
    "minimumCheckIntervalHours": 24,
    "startupDelaySeconds": 15,
    "github": {
      "owner": "danjboyd",
      "repo": "gnustep-performance-dashboard",
      "tagPattern": "v{version}",
      "releaseNotesUrlPattern": "https://github.com/{owner}/{repo}/releases/tag/{tag}"
    }
  },
  "integrations": {
    "shortcutName": "Performance Dashboard",
    "categories": [
      "Development",
      "Profiling"
    ],
    "fileAssociations": []
  },
  "compliance": {
    "runtimeNotices": [
      {
        "name": "Performance Dashboard",
        "version": "0.1.1",
        "license": "GPL-3.0-or-later",
